FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y \
    build-essential \
    libssl-dev \
    libpcre3-dev \
    libapr1-dev libaprutil1-dev \
    python3 python3-venv python3-pip \
    make git wget curl \
    && python3 -m venv /opt/venv \
    && /opt/venv/bin/pip install pytest \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
