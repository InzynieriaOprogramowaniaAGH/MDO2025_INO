FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    libssl3 \
    libpcre3 \
    libapr1 \
    libaprutil1 \
    libexpat1 \
    ca-certificates \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /httpd/install

COPY install/ /httpd/install/

RUN echo "ServerName localhost" >> /httpd/install/conf/httpd.conf

EXPOSE 80 443

CMD ["/httpd/install/bin/httpd", "-D", "FOREGROUND"]
