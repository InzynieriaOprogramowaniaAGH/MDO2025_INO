FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    libssl3 \
    libpcre3 \
    libapr1 \
    libaprutil1 \
    libexpat1 \
    ca-certificates \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /httpd/install

COPY install/ /usr/local/apache2/

ENV PATH=/httpd/install/bin:$PATH

EXPOSE 80 443

CMD ["/usr/local/apache2/bin/httpd", "-D", "FOREGROUND"]
