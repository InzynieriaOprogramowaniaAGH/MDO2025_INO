FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    libssl3 \
    libpcre3 \
    libapr1 \
    libaprutil1 \
    libexpat1 \
    ca-certificates \
 && rm -rf /var/lib/apt/lists/*

COPY install/ /httpd/install/

RUN chown -R www-data:www-data /httpd/install \
    && chmod -R 755 /httpd/install \
    && chmod -R 775 /httpd/install/logs /httpd/install/state /httpd/install/htdocs

ENV PATH=/httpd/install/bin:$PATH
WORKDIR /httpd/install

RUN echo "ServerName localhost" >> /httpd/install/conf/httpd.conf

EXPOSE 80

CMD ["/httpd/install/bin/httpd", "-D", "FOREGROUND"]
